# ============================================================
#  git 에 올리지 않을 파일 목록
#  (여기 적힌 것은 내 컴퓨터에만 남고, 저장소에는 안 들어갑니다)
# ============================================================

# ⚠️ API 키 등 비밀정보 — 절대 커밋하지 않습니다
.env
.env.*
!.env.example

# 검증용 스크린샷 (다시 만들 수 있으므로 저장하지 않음)
# 꼭 넣어야 하는 이미지가 생기면 git add -f 로 강제 추가하세요
*.png

# Playwright 검증 중 생기는 임시 폴더
.playwright-mcp/

# 엑셀·워드·한글이 파일을 열어 둘 때 만드는 임시파일
~$*
*.tmp
*.bak
*.~*

# Windows / macOS 탐색기가 만드는 파일
Thumbs.db
desktop.ini
.DS_Store

# 편집기 개인 설정 (사람마다 다르므로 공유하지 않음)
.vscode/
.idea/
*.swp

# Claude Code 개인 설정 (권한 등 내 PC 전용)
.claude/settings.local.json

# 파이썬
__pycache__/
*.pyc
.venv/
venv/

# Node (지금은 외부 패키지를 쓰지 않지만, 실수로 설치될 때 대비)
node_modules/
npm-debug.log*

# 압축해서 내보낸 결과물 (원본이 이 폴더에 이미 있음)
*.zip
